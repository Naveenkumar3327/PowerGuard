# ==========================================
# POWERGUARD: Environment Configuration
# ==========================================

# Port Configuration
PORT=5000
AI_SERVICE_PORT=8000
PORT_WEB=3000

# Backend & AI Service URLs
NODE_ENV=development
API_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_WS_URL=http://localhost:5000
AI_SERVICE_URL=http://localhost:8000

# Database Configuration
# Provide MongoDB Atlas connection string, e.g.:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/powerguard?retryWrites=true&w=majority
# If left empty, PowerGuard automatically uses an embedded local database fallback.
MONGODB_URI=mongodb://localhost:27017/powerguard

# JWT Authentication
JWT_SECRET=powerguard_super_secure_jwt_secret_key_2026_industrial_ai_final_year
JWT_EXPIRES_IN=7d

# Industrial Energy Tariffs & Environmental Constants
ENERGY_TARIFF=0.15           # USD ($) or local currency per kWh standard tariff
PEAK_TARIFF=0.28             # USD ($) per kWh peak demand tariff
EMISSION_FACTOR=0.42         # kg CO2 emitted per kWh
PEAK_DEMAND_THRESHOLD_KW=160 # Factory aggregate power threshold for peak demand alerts (kW)

# Multi-Agent Engine Mode: AUTO | ASSISTED | MANUAL
AI_SYSTEM_MODE=ASSISTED

# Machine Simulator Configuration
SIMULATION_TICK_MS=2000      # Telemetry update interval (2000ms = 2s)
SIMULATION_SPEED=1           # Multiplier: 1, 2, 5, 10

# AI LLM Provider Keys (Optional for enhanced natural language explanations)
# If left empty, the built-in deterministic Explainability & Supervisor Engine generates high-accuracy explanations.
GEMINI_API_KEY=
OPENAI_API_KEY=
